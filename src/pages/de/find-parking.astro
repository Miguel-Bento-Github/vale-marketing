---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import FindParking from '../../components/FindParking.astro';
import Footer from '../../components/Footer.astro';

const locale = 'de';
---

<Layout
  title="Parkplatz in Ihrer Nähe finden - Vale"
  description="Buchen Sie einen garantierten Parkplatz an einem unserer Partnerstandorte."
  locale={locale}
  widgetPreconnect
>
  <Navigation locale={locale} />
  <main>
    <FindParking locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
