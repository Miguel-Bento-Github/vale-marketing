---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import FindParking from '../../components/FindParking.astro';
import Footer from '../../components/Footer.astro';

const locale = 'en';
---

<Layout
  title="Find Parking Near You - Vale"
  description="Book a guaranteed parking spot at one of our partner locations. Pay online and get gate access on your phone."
  locale={locale}
>
  <Navigation locale={locale} />
  <main>
    <FindParking locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
