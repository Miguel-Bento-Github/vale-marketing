---
import { getTranslations } from '../i18n/translations';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const API_BASE_URL = 'https://vale.up.railway.app';
const WIDGET_API_KEY = '51008ecb5d6ba6f1673aaa124971236c105a2f5d0185c7a1911d7586d35d1c92';
const WIDGET_SCRIPT_URL = 'https://widget.valepark.org/vale-widget-cdn.js';
---

<section id="find-parking" class="relative min-h-screen overflow-hidden pt-28 pb-20 bg-themed">
  <!-- Background -->
  <div class="absolute inset-0 vale-gradient opacity-5 dark:opacity-10"></div>
  <div class="absolute top-0 left-1/3 w-96 h-96 bg-vale-primary/10 dark:bg-vale-primary/20 rounded-full blur-3xl animate-pulse-slow"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-vale-accent/10 dark:bg-vale-accent/15 rounded-full blur-3xl animate-pulse-slow" style="animation-delay: 2s;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h1 class="text-4xl sm:text-5xl font-bold mb-6 animate-fade-up">
        <span class="text-themed">{t.findParking.title}</span>
        <span class="vale-text-gradient">{t.findParking.titleHighlight}</span>
      </h1>
      <p class="text-xl text-themed-secondary leading-relaxed animate-fade-up stagger-2">
        {t.findParking.description}
      </p>
    </div>

    <!-- Controls -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10 animate-fade-up stagger-3">
      <button
        id="locate-button"
        class="glass text-themed px-6 py-3 rounded-xl font-semibold transition-all hover:bg-vale-primary/10 flex items-center gap-2"
      >
        <svg class="w-5 h-5 text-vale-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {t.findParking.useMyLocation}
      </button>
      <span id="locate-status" class="text-sm text-themed-secondary" aria-live="polite"></span>
    </div>

    <!-- Loading state -->
    <div id="locations-loading" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" aria-hidden="true">
      {Array.from({ length: 6 }).map(() => (
        <div class="glass rounded-2xl p-6 animate-pulse">
          <div class="h-5 w-2/3 rounded bg-themed-tertiary mb-4"></div>
          <div class="h-4 w-full rounded bg-themed-tertiary mb-2"></div>
          <div class="h-4 w-1/2 rounded bg-themed-tertiary mb-6"></div>
          <div class="h-10 w-full rounded-lg bg-themed-tertiary"></div>
        </div>
      ))}
    </div>

    <!-- Error state -->
    <div id="locations-error" class="hidden text-center py-16">
      <p class="text-themed-secondary mb-6">{t.findParking.loadFailed}</p>
      <button
        id="retry-button"
        class="bg-vale-primary hover:bg-vale-primary/90 text-white px-6 py-3 rounded-xl font-semibold transition-all"
      >
        {t.findParking.retry}
      </button>
    </div>

    <!-- Empty state -->
    <div id="locations-empty" class="hidden text-center py-16">
      <p class="text-themed-secondary">{t.findParking.noLocations}</p>
    </div>

    <!-- Locations grid -->
    <div id="locations-grid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>
  </div>
</section>

<script
  define:vars={{
    apiBaseUrl: API_BASE_URL,
    apiKey: WIDGET_API_KEY,
    widgetScriptUrl: WIDGET_SCRIPT_URL,
    locale,
    i18n: {
      locating: t.findParking.locating,
      locationDenied: t.findParking.locationDenied,
      sortedByDistance: t.findParking.sortedByDistance,
      book: t.findParking.book,
      kmAway: t.findParking.kmAway,
      spots: t.findParking.spots,
    },
  }}
>
  const grid = document.getElementById('locations-grid');
  const loading = document.getElementById('locations-loading');
  const errorBox = document.getElementById('locations-error');
  const emptyBox = document.getElementById('locations-empty');
  const locateButton = document.getElementById('locate-button');
  const locateStatus = document.getElementById('locate-status');
  const retryButton = document.getElementById('retry-button');

  let locations = [];
  let widgetReadyPromise = null;

  function escapeHtml(value) {
    const div = document.createElement('div');
    div.textContent = String(value ?? '');
    return div.innerHTML;
  }

  function ensureWidgetReady() {
    widgetReadyPromise ??= (async () => {
      let stripePublishableKey;
      try {
        const response = await fetch(`${apiBaseUrl}/api/config/stripe-key`);
        const payload = await response.json();
        stripePublishableKey = payload?.data?.publishableKey || undefined;
      } catch {
        stripePublishableKey = undefined;
      }

      window.ValeWidgetConfig = {
        apiKey,
        baseUrl: apiBaseUrl,
        stripePublishableKey,
        language: locale,
      };

      await new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = widgetScriptUrl;
        script.async = true;
        script.onload = resolve;
        script.onerror = () => reject(new Error('widget script failed to load'));
        document.head.appendChild(script);
      });
    })();
    return widgetReadyPromise;
  }

  async function openWidget() {
    try {
      await ensureWidgetReady();
      window.ValeWidget.open();
    } catch {
      widgetReadyPromise = null; // allow retry on next click
    }
  }

  function distanceKm(from, to) {
    const R = 6371;
    const dLat = ((to.latitude - from.latitude) * Math.PI) / 180;
    const dLng = ((to.longitude - from.longitude) * Math.PI) / 180;
    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos((from.latitude * Math.PI) / 180) *
        Math.cos((to.latitude * Math.PI) / 180) *
        Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  function renderLocations() {
    grid.innerHTML = locations
      .map((location) => {
        const spotCount = (location.spots || []).filter((s) => s.isActive !== false).length;
        const distanceChip =
          location.distanceKm === undefined
            ? ''
            : `<span class="inline-flex items-center rounded-full bg-vale-accent/10 text-vale-accent px-3 py-1 text-xs font-semibold">${location.distanceKm.toFixed(1)} ${i18n.kmAway}</span>`;
        return `
          <div class="glass rounded-2xl p-6 flex flex-col transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-vale-primary/10">
            <div class="flex items-start justify-between gap-2 mb-3">
              <h2 class="text-lg font-semibold text-themed">${escapeHtml(location.name)}</h2>
              ${distanceChip}
            </div>
            <p class="text-sm text-themed-secondary leading-relaxed mb-4 flex-1">${escapeHtml(location.address)}</p>
            <div class="flex items-center justify-between gap-4">
              <span class="inline-flex items-center rounded-full bg-vale-primary/10 text-vale-primary px-3 py-1 text-xs font-semibold">${spotCount} ${i18n.spots}</span>
              <button
                type="button"
                data-book
                class="bg-vale-primary hover:bg-vale-primary/90 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition-all hover:shadow-lg hover:shadow-vale-primary/25"
              >
                ${i18n.book}
              </button>
            </div>
          </div>
        `;
      })
      .join('');

    grid.querySelectorAll('[data-book]').forEach((button) => {
      button.addEventListener('click', () => {
        void openWidget();
      });
    });
  }

  async function fetchLocations() {
    loading.classList.remove('hidden');
    errorBox.classList.add('hidden');
    emptyBox.classList.add('hidden');
    grid.classList.add('hidden');

    try {
      const response = await fetch(`${apiBaseUrl}/api/widget/v1/locations?limit=50`, {
        headers: { 'X-API-Key': apiKey },
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const payload = await response.json();
      locations = payload?.data?.locations || [];

      loading.classList.add('hidden');
      if (locations.length === 0) {
        emptyBox.classList.remove('hidden');
        return;
      }
      renderLocations();
      grid.classList.remove('hidden');
    } catch {
      loading.classList.add('hidden');
      errorBox.classList.remove('hidden');
    }
  }

  function locate() {
    if (!navigator.geolocation) {
      locateStatus.textContent = i18n.locationDenied;
      return;
    }
    locateStatus.textContent = i18n.locating;
    navigator.geolocation.getCurrentPosition(
      (position) => {
        const here = {
          latitude: position.coords.latitude,
          longitude: position.coords.longitude,
        };
        locations.forEach((location) => {
          if (location.coordinates) {
            location.distanceKm = distanceKm(here, location.coordinates);
          }
        });
        locations.sort((a, b) => (a.distanceKm ?? Infinity) - (b.distanceKm ?? Infinity));
        renderLocations();
        locateStatus.textContent = i18n.sortedByDistance;
      },
      () => {
        locateStatus.textContent = i18n.locationDenied;
      },
      { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 }
    );
  }

  locateButton?.addEventListener('click', locate);
  retryButton?.addEventListener('click', fetchLocations);

  void ensureWidgetReady();
  fetchLocations();
</script>
